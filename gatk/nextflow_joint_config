params {
    outdir = "./results"
    fastp_bin = "/home/mrichardson/bin/fastp" 
}

// ------------------------------------------------------------------
// EXECUTOR SETTINGS 
// ------------------------------------------------------------------
executor {
    name = 'slurm'
    queueSize = 240
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    clusterOptions = '--account=pawsey0149' 
    queue    = 'work'                       
    cache = 'lenient'

    errorStrategy = { task.exitStatus in [143,137,104,134,139,140,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // ------------------------------------------------------------------
    // RESOURCE ALLOCATION 
    // ------------------------------------------------------------------
    
    withName: 'FASTP' {
        cpus   = 4
        memory = '8 GB'  
        time   = '2h'
    }
    
    withName: 'ALIGN_AND_PREPROCESS' {
        module = 'gatk4/4.2.5.0--hdfd78af_0:bwa-mem2/2.2.1--hd03093a_2:samtools/1.15--h3843a85_0'
        cpus   = 16
        memory = { 32.GB * task.attempt } 
        time   = '16h'   
    }
    
    withName: 'HAPLOTYPE_CALLER' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 4
        memory = '8 GB'
        time   = { 6.h * task.attempt } 
    }
    
    withName: 'MERGE_SINGLE_SAMPLE_GVCFS' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 2
        memory = '8 GB'
        time   = '3h'
    }
    
    withName: 'GENOMICS_DB' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 4 
        memory = '48 GB' 
        time   = { 8.h * task.attempt }
    }
    
    withName: 'GENOTYPE_COHORT' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 4
        memory = '24 GB'
        time   = '8h'
    }
    
    withName: 'MERGE_COHORT_FINAL' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 2
        memory = '16 GB'
        time   = '4h'
    }
    
    withName: 'FILTER_COHORT' {
        module = 'gatk4/4.2.5.0--hdfd78af_0'
        cpus   = 2
        memory = '16 GB'
        time   = '2h'
    }
}

// ------------------------------------------------------------------
// INTROSPECTION
// ------------------------------------------------------------------
timeline {
  enabled = true
  file = "${params.outdir}/pipeline_info/timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.outdir}/pipeline_info/report.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.outdir}/pipeline_info/trace.txt"
  overwrite = true
}